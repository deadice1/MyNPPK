<?xml version="1.0" encoding="utf-8"?>
<!-- «Облако»: два смещённых скруглённых слоя + мягкая обводка -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="0dp"
        android:top="6dp"
        android:right="10dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#CCD4EFFF" />
            <corners android:radius="36dp" />
        </shape>
    </item>
    <item
        android:left="8dp"
        android:top="0dp"
        android:right="0dp"
        android:bottom="8dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:endColor="#FFF5FBFF"
                android:startColor="#FFE0F0FF"
                android:type="linear" />
            <corners android:radius="40dp" />
            <stroke
                android:width="1dp"
                android:color="@color/map_bubble_stroke" />
        </shape>
    </item>
</layer-list>
